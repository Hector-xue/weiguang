<?xml version="1.0" encoding="utf-8"?>
<!-- 听歌人格小组件：这周你是「夜航人」+ 一句话 + 两个数。点开就是本周回顾卡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/r_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="这周你是"
        android:textColor="#A29DB3"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/r_persona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="刚认识"
        android:textColor="#2E2A3F"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/r_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="3"
        android:text="多陪我听听，就能认出你是哪种人"
        android:textColor="#6E6982"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 小组件里不能用普通 View，圆点用 ImageView 画 -->
        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/r_dot" />

        <TextView
            android:id="@+id/r_stat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="微光"
            android:textColor="#A29DB3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
